// Integration example: copy into the mod and call Register() from Entry.Init().
// Put Package/* in Resources/Audio and include *.bank,GUIDs.txt in Godot export.
using STS2RitsuLib.Audio;

namespace Sts2HollowKnightMod.Scripts.Audio;

public static class HollowKnightAudio
{
    public static void Register()
    {
        FmodStudioDeferredBankRegistration.RegisterBank("res://Resources/Audio/HK_Emiya_SFX.bank");
        FmodStudioDeferredBankRegistration.RegisterBank("res://Resources/Audio/HK_Emiya_Music.bank");
        FmodStudioDeferredBankRegistration.RegisterBank("res://Resources/Audio/HK_Emiya_VoidHeart.bank");
        FmodStudioDeferredBankRegistration.RegisterStudioGuidMappings("res://Resources/Audio/GUIDs.txt");
    }
